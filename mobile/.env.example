# Firebase — get these from Firebase Console → Project Settings → Web App
# (same project the web app at ../web uses, so data is shared)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional web OAuth client ID; required for Android Google sign-in.
# iPhone uses CLIENT_ID from the local GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Deployed web API and invitation links (HTTPS required in release builds).
EXPO_PUBLIC_APP_URL=https://transactions-lmct.vercel.app
